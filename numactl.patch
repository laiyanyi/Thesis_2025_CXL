diff --git a/libnuma.c b/libnuma.c
index 380e8a6..795e959 100644
--- a/libnuma.c
+++ b/libnuma.c
@@ -19,6 +19,7 @@
    All calls are undefined when numa_available returns an error. */
 #define _GNU_SOURCE 1
 #include <stdlib.h>
+#include <stdint.h>
 #include <stdio.h>
 #include <unistd.h>
 #include <string.h>
@@ -85,7 +86,7 @@ static int has_preferred_many = -1;
 int numa_exit_on_error = 0;
 int numa_exit_on_warn = 0;
 static void set_sizes(void);
-
+uint8_t *weights =NULL;
 /*
  * There are two special functions, _init(void) and _fini(void), which
  * are called automatically by the dynamic loader whenever a library is loaded.
@@ -106,7 +107,7 @@ numa_init(void)
         for (i = 0; i < max; i++)
                 nodemask_set_compat((nodemask_t *)&numa_all_nodes, i);
 	memset(&numa_no_nodes, 0, sizeof(numa_no_nodes));
-
+	weights = (uint8_t*)malloc((1 << 10)*sizeof(uint8_t));
 	/* clear errno */
 	errno = 0;
 }
@@ -310,8 +311,15 @@ WEAK void numa_warn(int num, char *fmt, ...)
 
 static void setpol(int policy, struct bitmask *bmp)
 {
-	if (set_mempolicy(policy, bmp->maskp, bmp->size + 1) < 0)
-		numa_error("set_mempolicy");
+	if(policy==MPOL_WEIGHTED_INTERLEAVE_PROCESS){
+		if (set_mempolicy_new(policy, bmp->maskp, bmp->size+1,weights) < 0)
+			numa_error("set_mempolicy");
+	}else{
+		if (set_mempolicy(policy, bmp->maskp, bmp->size + 1) < 0){
+			printf("setpol_normal\n");
+			numa_error("set_mempolicy");
+		}
+	}
 }
 
 static void getpol(int *oldpolicy, struct bitmask *bmp)
@@ -1071,6 +1079,16 @@ numa_set_weighted_interleave_mask(struct bitmask *bmp)
 		setpol(MPOL_WEIGHTED_INTERLEAVE, bmp);
 }
 
+void
+numa_set_weighted_interleave_process_mask(struct bitmask *bmp)
+{
+	if (numa_bitmask_equal(bmp, numa_no_nodes_ptr))
+		setpol(MPOL_DEFAULT, bmp);
+	else
+		setpol(MPOL_WEIGHTED_INTERLEAVE_PROCESS, bmp);
+}
+
+
 SYMVER("numa_get_interleave_mask_v1", "numa_get_interleave_mask@libnuma_1.1")
 nodemask_t
 numa_get_interleave_mask_v1(void)
@@ -1122,6 +1140,21 @@ numa_get_weighted_interleave_mask(void)
 	return bmp;
 }
 
+struct bitmask *
+numa_get_weighted_interleave_process_mask(void)
+{
+	int oldpolicy = 0;
+	struct bitmask *bmp;
+
+	bmp = numa_allocate_nodemask();
+	if (!bmp)
+		return NULL;
+	getpol(&oldpolicy, bmp);
+	if (oldpolicy != MPOL_WEIGHTED_INTERLEAVE_PROCESS)
+		copy_bitmask_to_bitmask(numa_no_nodes_ptr, bmp);
+	return bmp;
+}
+
 /* (undocumented) */
 int numa_get_interleave_node(void)
 {
@@ -2341,3 +2374,10 @@ int numa_set_mempolicy_home_node(void *start, unsigned long len, int home_node,
 
 	return 0;
 }
+void set_process_weight(struct bitmask *nodemask,uint8_t *nweights){
+	int i;
+	memset(weights,0,(1 << 10)); 
+	for(i =0;i< nodemask->size;i++)
+		if (numa_bitmask_isbitset(nodemask, i))
+			*(weights+i) =nweights[i];
+}
\ No newline at end of file
