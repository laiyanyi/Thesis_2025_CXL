 #define NUMA_NUM_NODES  128
@@ -178,12 +179,17 @@ void numa_set_interleave_mask(struct bitmask *nodemask);
 /* Set the NUMA node weighted interleaving mask. 0 to turn off */
 void numa_set_weighted_interleave_mask(struct bitmask *nodemask);
 
+/* Set the NUMA node weighted interleaving mask. 0 to turn off */
+void numa_set_weighted_interleave_process_mask(struct bitmask *nodemask);
+
 /* Return the current interleaving mask */
 struct bitmask *numa_get_interleave_mask(void);
 
 /* Return the current weighted interleaving mask */
 struct bitmask *numa_get_weighted_interleave_mask(void);
 
+struct bitmask *numa_get_weighted_interleave_process_mask(void);
+
 /* allocate a bitmask big enough for all nodes */
 struct bitmask *numa_allocate_nodemask(void);
 
@@ -264,7 +270,8 @@ void numa_setlocal_memory(void *start, size_t size);
 
 /* Allocate memory area with current memory policy */
 void numa_police_memory(void *start, size_t size);
-
+void set_process_weight(struct bitmask *nodemask,uint8_t *nweights);
+void numa_set_weighted_interleave_process_mask(struct bitmask *bmp);
 /* Run current task only on nodes in mask */
 int numa_run_on_node_mask(struct bitmask *mask);
 /* Run current task on nodes in mask without any cpuset awareness */
diff --git a/numactl.c b/numactl.c
old mode 100755
new mode 100644
index 15d9877..c473d2b
--- a/numactl.c
+++ b/numactl.c
@@ -45,6 +45,7 @@ static struct option opts[] = {
 	{"all", 0, 0, 'a'},
 	{"interleave", 1, 0, 'i' },
 	{"weighted-interleave", 1, 0, 'w' },
+	{"weighted-interleave-process", 1, 0, 'W' },
 	{"preferred", 1, 0, 'p' },
 	{"preferred-many", 1, 0, 'P' },
 	{"cpubind", 1, 0, 'c' },
@@ -78,6 +79,7 @@ static void usage(void)
 	fprintf(stderr,
 		"usage: numactl [--all | -a] [--balancing | -b]\n"
 		"               [--interleave= | -i <nodes>] [--weighted-interleave= | -w <nodes>]\n"
+		"               [--weighted-interleave-process= | -W <nodes:weight>]\n"
 		"               [--preferred= | -p <node>] [--preferred-many= | -P <nodes>]\n"
 		"               [--physcpubind= | -C <cpus>] [--cpunodebind= | -N <nodes>]\n"
 		"               [--membind= | -m <nodes>] [--localalloc | -l] command args ...\n"
@@ -538,6 +540,74 @@ int main(int ac, char **av)
 			nopolicy();
 			numa_balancing = 1;
 			break;
+		case 'W': /* --weighted-interleave-process */
+			checknuma();
+			char ids[5000] = {0};  
+			//set weights
+			uint8_t weight[(1<<10)];
+			memset(&weight,1,(1<<10));
+			const char *p = optarg;
+			char good_weight=1;
+			while (*p) {
+				int id = 0, val = 1;  // 預設 value = 1
+
+				// 檢查是否有 ':' 分隔符
+				const char *colon = strchr(p, ':');
+				const char *comma = strchr(p, ',');
+
+				if (colon && (!comma || colon < comma)) {
+					// 有 ':' 且 ':' 在下一個 ',' 前
+					sscanf(p, " %d:%d", &id, &val);
+				} else {
+					// 沒有 ':'，只提取 index，value 預設為 1
+					sscanf(p, " %d", &id);
+				}
+
+				if (id >= 0 && id < (1<<10)) {
+					weight[id] = (unsigned char)val;
+				} else {
+					good_weight = 0;
+				}
+
+				// 拼接 id 字符串
+				char tmp[20];
+				sprintf(tmp, "%d,", id);
+				strcat(ids, tmp);
+
+				// 跳到下一個逗號
+				while (*p && *p != ',') p++;
+				if (*p == ',') p++;
+			}
+			int len = strlen(ids);
+			if (len > 0 && ids[len - 1] == ',') {
+				ids[len - 1] = '\0';
+			}
+			//usage_msg("optarg = %s",ids);
+			if (parse_all)
+				mask = numactl_parse_nodestring(ids, ALL);
+			else
+				mask = numactl_parse_nodestring(ids, CPUSET);
+			if (!mask) {
+				printf ("mask k<%s> is invalid\n", optarg);
+				usage();
+			}
+			if (!good_weight) {
+				printf ("weight <%s> is invalid\n", optarg);
+				usage();
+			}
+			setpolicy(MPOL_WEIGHTED_INTERLEAVE_PROCESS);
+			
+			
+			set_process_weight(mask,&weight);
+			
+			//
+			if (shmfd >= 0)
+				numa_interleave_memory(shmptr, shmlen, mask);
+			else {
+				numa_set_weighted_interleave_process_mask(mask);
+			}
+			checkerror("setting process interleave mask");
+			break;
 		case 'w': /* --weighted-interleave */
 			weighted_interleave = 1;
 			/* fall-through - logic is the same as interleave */
